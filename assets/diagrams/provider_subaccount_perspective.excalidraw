      "updated": 1770820903807,
      "link": null,
      "locked": false,
      "text": "2. Get: Endpoint: /users/:id/stack\n\nResponse: HTTP 201 OK.\n        {\n           profiles: [\n                {\n                  Partial Data 1   \n                },\n                {\n                  Partial Data 1   \n                }\n            ]  \n         }\n        ",
      "fontSize": 14.551185546874995,
