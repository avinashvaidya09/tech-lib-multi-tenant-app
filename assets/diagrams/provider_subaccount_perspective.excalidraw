    {
      "id": "TKowjNduZCtAPFgQjdrfo",
      "type": "text",
      "x": 2830.93687140085,
      "y": 1703.5071411725887,
      "width": 731.6474609375,
      "height": 140,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "9o1N9okmjUrr8qAlkqzhO",
      "index": "bim",
      "roundness": null,
      "seed": 1923591297,
      "version": 568,
      "versionNonce": 463869119,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1770820903807,
      "link": null,
      "locked": false,
      "text": "The Happy path swipe process works fine except below\n1. Person A swipe hits the server and we check for inverse swipe. Nothing.\n2. Person B swipe hits the server and we check for inverse swipe at the same time. Nothing.\n3. We save Person A swipe on Person B.\n4. We save Person B swipe on Person A.\nWe have saved the swipes but we have lost the opportunity to send then match notification.\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The Happy path swipe process works fine except below\n1. Person A swipe hits the server and we check for inverse swipe. Nothing.\n2. Person B swipe hits the server and we check for inverse swipe at the same time. Nothing.\n3. We save Person A swipe on Person B.\n4. We save Person B swipe on Person A.\nWe have saved the swipes but we have lost the opportunity to send then match notification.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "3h4tV463OSIzzwDBzQ55L",
      "type": "text",
      "x": 3148.7954119216,
      "y": 2169.0907392973236,
      "width": 581.1991171242053,
      "height": 50,
      "angle": 0,
      "strokeColor": "#e8590c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "lH6xAEtUNjqmCqP_cnAmU",
      "index": "bio",
      "roundness": null,
      "seed": 1606546575,
      "version": 356,
      "versionNonce": 1761729201,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1770820903807,
      "link": null,
      "locked": false,
      "text": "Constraint: We loose the consistency as Cassandra is\neventual consistent.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Constraint: We loose the consistency as Cassandra is eventual consistent.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "tIbXl_u6iYwIUbInMr8cA",
      "type": "text",
      "x": 3156.222947747277,
      "y": 2233.5290681315932,
      "width": 578.0465240478517,
      "height": 125,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "lH6xAEtUNjqmCqP_cnAmU",
      "index": "bip",
      "roundness": null,
      "seed": 1304627937,
      "version": 2801,
      "versionNonce": 77800671,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1770820903807,
      "link": null,
      "locked": false,
      "text": "Solution-1 - Sharded Cassandra with Single Partition\ntransactions.\n\nSolution-2 - Add Redis to check the swipe matches.\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Solution-1 - Sharded Cassandra with Single Partition transactions.\n\nSolution-2 - Add Redis to check the swipe matches.\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
