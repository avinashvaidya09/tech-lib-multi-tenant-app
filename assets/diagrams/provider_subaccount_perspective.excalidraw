    },
    {
      "id": "rN9WDGH1xCJGV2rBjXJpl",
      "type": "text",
      "x": 322.1647491455078,
      "y": 364.552276611328,
      "width": 213.64991075538825,
      "height": 455.1433105468749,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
