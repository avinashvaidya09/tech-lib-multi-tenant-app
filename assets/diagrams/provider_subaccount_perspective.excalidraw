      "name": "1.b Solution-2"
    },
    {
      "id": "4eHbqafdrGDDeEzZAhLDU",
      "type": "text",
      "x": 1008.298406099543,
      "y": 2810.8802061909996,
      "width": 578.0465240478517,
      "height": 350,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "JqKA0pi1bI33Aoq2u88_j",
      "index": "bj6",
      "roundness": null,
      "seed": 985706511,
      "version": 3131,
      "versionNonce": 1213182367,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1770820903807,
      "link": null,
      "locked": false,
      "text": "- When use opens the app, he should quickly see the stack\non the screen. They do not have to wait for us to\ngenerate the feed.\n\n- The simplest approach is to run a sql query to get the\nstack - \n\nSELECT * FROM users\nWHERE age BETWEEN 18 AND 35\nAND interestedIn = 'female'\nAND lat BETWEEN userLat - maxDistance AND userLat +\nmaxDistance\nAND long BETWEEN userLong - maxDistance AND\nuserLong + maxDistance",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- When use opens the app, he should quickly see the stack on the screen. They do not have to wait for us to generate the feed.\n\n- The simplest approach is to run a sql query to get the stack - \n\nSELECT * FROM users\nWHERE age BETWEEN 18 AND 35\nAND interestedIn = 'female'\nAND lat BETWEEN userLat - maxDistance AND userLat + maxDistance\nAND long BETWEEN userLong - maxDistance AND userLong + maxDistance",
      "autoResize": false,
      "lineHeight": 1.25
    },
