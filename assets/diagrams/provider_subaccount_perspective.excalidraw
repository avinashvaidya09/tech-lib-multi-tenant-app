      "name": "1.a Solution-1"
    },
    {
      "id": "u61-NnanBLtQVXLec5tE8",
      "type": "text",
      "x": 3000.576466083526,
      "y": 2510.058417748667,
      "width": 581.1991171242053,
      "height": 200,
      "angle": 0,
      "strokeColor": "#e8590c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "gJ4QBiXQgfUrJP1cV6aLk",
      "index": "bj0",
      "roundness": null,
      "seed": 2027069697,
      "version": 633,
      "versionNonce": 2122464575,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1770820903807,
      "link": null,
      "locked": false,
      "text": "Challenges: \n- As use pair accumulates over time, partition size can\ngrow significantly, impacting performance.\n\n- Highly active users could create hot partitions.\n\n- Robust clean up strategy to archive or delete old swipes\ndata is required.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Challenges: \n- As use pair accumulates over time, partition size can grow significantly, impacting performance.\n\n- Highly active users could create hot partitions.\n\n- Robust clean up strategy to archive or delete old swipes data is required.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "JIaAaW7zVKGOIvJbWnByT",
      "type": "text",
      "x": 3014.5233614274057,
      "y": 2723.9334672808595,
      "width": 578.0465240478517,
      "height": 50,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "gJ4QBiXQgfUrJP1cV6aLk",
      "index": "bj1",
      "roundness": null,
      "seed": 454424833,
      "version": 2960,
      "versionNonce": 1337621041,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1770820903807,
      "link": null,
      "locked": false,
      "text": "This is a good option, but we have one more option using\nRedis",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This is a good option, but we have one more option using Redis",
      "autoResize": false,
      "lineHeight": 1.25
    },
