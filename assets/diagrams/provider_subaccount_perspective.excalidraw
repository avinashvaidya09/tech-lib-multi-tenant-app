      "index": "bVj",
      "roundness": null,
      "seed": 69604394,
      "version": 1967,
      "versionNonce": 2084224639,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1770820903807,
      "link": null,
      "locked": false,
      "text": "1. Users\n    - id\n    - name\n    - email\n    - age\n    - sex\n    - status: ACTIVE| INACTIVE\n    - profile_metadata...\n    ...\n\n2. Swipes \n    - id\n    - userid1\n    - userid2\n    - userid1_decision\n    - userid2_decision\n    - metadata\n    ...\n\n3. Match\n    - id\n    - userid1\n    - userid2\n    ...\n",
      "fontSize": 14.564585937499997,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Users\n    - id\n    - name\n    - email\n    - age\n    - sex\n    - status: ACTIVE| INACTIVE\n    - profile_metadata...\n    ...\n\n2. Swipes \n    - id\n    - userid1\n    - userid2\n    - userid1_decision\n    - userid2_decision\n    - metadata\n    ...\n\n3. Match\n    - id\n    - userid1\n    - userid2\n    ...\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
