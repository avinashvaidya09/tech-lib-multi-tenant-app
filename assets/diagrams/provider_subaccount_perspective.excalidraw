    {
      "id": "AgjPv7fad0z6_84RdDRCs",
      "type": "text",
      "x": 1571.6337419472086,
      "y": 1699.9662267844033,
      "width": 826.9912719726562,
      "height": 120,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "9o1N9okmjUrr8qAlkqzhO",
      "index": "bik",
      "roundness": null,
      "seed": 639418127,
      "version": 109,
      "versionNonce": 1372907647,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1770820903807,
      "link": null,
      "locked": false,
      "text": "Happy Path:\n1. Person A swiped right on Person B and we persisted this swipe in our Swipe DB.\n2. Person B swipes right on Person A.\n3. The server checks for an inverse swipe and finds that it does, indeed, exist.\n4. We display a \"You Matched!\" message to Person B immediately after swiping.\n5. We send a push notification via APNS or FCM to Person A informing them that they have a new match.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Happy Path:\n1. Person A swiped right on Person B and we persisted this swipe in our Swipe DB.\n2. Person B swipes right on Person A.\n3. The server checks for an inverse swipe and finds that it does, indeed, exist.\n4. We display a \"You Matched!\" message to Person B immediately after swiping.\n5. We send a push notification via APNS or FCM to Person A informing them that they have a new match.",
      "autoResize": true,
      "lineHeight": 1.25
    },
