      "boundElements": [],
      "updated": 1770820903807,
      "link": null,
      "locked": false,
      "text": "3. Create: POST. Endpoint:\n/users/:id/swipe\n\nRequest Body:\n    {\n        swipe: {\n           flag (yes/no),\n           userId2 \n        },\n        dateTime:<DateTime>\n        ...\n        ...\n    }\n\nResponse: HTTP 201 OK.\n        {\n            status: SUCCESS/ERROR\n            matchFound: Yes\n            matchData: {\n            ....\n            ....\n            }\n         }\n        ",
      "fontSize": 14.551185546874995,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
